<Window x:Class="toolbox.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:toolbox.Models"
        Title="紀錄" Width="860" Height="660" MinWidth="680" MinHeight="440" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- 兩個分頁：借出中（可直接歸還）、紀錄（購入 / 報廢 / 借出 / 歸還 / 盤點，最新的在上面） -->
    <Window.Resources>
        <!-- 分頁按鈕：目前的分頁由程式設成淡強調色底 -->
        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- 動作徽章：購入 / 歸還綠色、報廢紅色、借出琥珀色、盤點主色 -->
        <Style x:Key="KindBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RecordKind.Buy}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RecordKind.Return}">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RecordKind.Scrap}">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RecordKind.Lend}">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="12,12,6,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 分頁切換 + 篩選 -->
        <DockPanel Margin="0,0,0,14">
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="LoansTab" Style="{StaticResource TabButton}" Click="LoansTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock x:Name="LoansTabText" Text="借出中"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecordsTab" Style="{StaticResource TabButton}" Click="RecordsTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="全部紀錄"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 從某項工具打開時：只看這項（按 ✕ 看全部） -->
                <Button x:Name="ItemFilterButton" Padding="10,7" Margin="0,0,8,0" FontSize="12" ToolTip="按一下改看全部工具"
                        Click="ItemFilter_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ItemFilterText" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <ComboBox x:Name="KindFilter" Width="110" Margin="0,0,8,0" SelectionChanged="Filter_Changed"/>
                <Grid Width="220">
                    <TextBox x:Name="SearchBox" Padding="34,8,12,8" TextChanged="Filter_Changed"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SubtleBrush}"
                               Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="搜尋工具、原因、借用人" Margin="35,0,0,0" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- 借出中 -->
        <Border x:Name="LoansPage" Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <ListBox x:Name="LoanList" Style="{StaticResource EntryListStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource WarnSoftBrush}">
                                    <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource WarnBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ItemDisplay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Detail}"/>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Background="{DynamicResource WarnSoftBrush}">
                                    <TextBlock Text="{Binding QuantityDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                                </Border>
                                <Button Grid.Column="3" Padding="12,6" FontSize="12" Click="ReturnLoan_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="歸還"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LoansEmpty" Text="目前沒有借出未還的工具" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 全部紀錄 -->
        <Border x:Name="RecordsPage" Grid.Row="1" Style="{StaticResource Card}" Visibility="Collapsed">
            <Grid>
                <ListBox x:Name="RecordList" Style="{StaticResource EntryListStyle}" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource KindBadge}">
                                    <TextBlock Text="{Binding KindDisplay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ItemDisplay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Detail}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding QuantityDisplay}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding TimeDisplay, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="">
                                    <Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="RecordsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="4,12,0,0">
            <Button DockPanel.Dock="Right" IsCancel="True" MinWidth="88" Content="關閉"/>
            <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
