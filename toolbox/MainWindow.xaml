<Window x:Class="toolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:toolbox"
        Title="工具盤點" Height="820" Width="1260" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 卡片：白底、細框、大圓角；陰影放在另一層（見 CardShadow），避免內文被模糊 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.07" Color="#1E1B4B"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 輸入框上的灰色提示文字：輸入框為空時才顯示 -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 清單項目：彩色頭像 + 名稱 + 規格（或備註）+ 數量徽章 -->
        <DataTemplate x:Key="ToolTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{Binding AvatarColor}">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 借出徽章：有借出沒還時才出現 -->
                    <Border x:Name="LentBadge" CornerRadius="8" Padding="8,4" Margin="0,0,6,0" Visibility="Collapsed"
                            Background="{DynamicResource WarnSoftBrush}" ToolTip="借出未還">
                        <TextBlock Text="{Binding LentDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                    </Border>
                    <!-- 數量徽章（在庫數量）：數量為 0 時變紅 -->
                    <Border x:Name="QtyBadge" CornerRadius="8" Padding="10,4"
                            Background="{DynamicResource AccentSoftBrush}" ToolTip="在庫數量">
                        <TextBlock x:Name="QtyText" Text="{Binding QuantityDisplay}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="QtyBadge" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                    <Setter TargetName="QtyText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Subtitle}" Value="">
                    <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLent}" Value="True">
                    <Setter TargetName="LentBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 全部報廢：徽章改成灰色「已報廢」 -->
                <DataTrigger Binding="{Binding IsScrapped}" Value="True">
                    <Setter TargetName="QtyText" Property="Text" Value="已報廢"/>
                    <Setter TargetName="QtyBadge" Property="Background" Value="{DynamicResource InputBgBrush}"/>
                    <Setter TargetName="QtyText" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    <Setter TargetName="QtyBadge" Property="ToolTip" Value="全部都報廢了"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,22,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 標題列 ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- 工具列：一條白色膠囊裡放幾個透明按鈕 -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <!-- 主題：按一下依序切換 跟隨系統 → 淺色 → 深色（圖示與提示文字由程式設定） -->
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Padding="10,8" Click="Theme_Click">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;"/>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" ToolTip="盤點左側目前選的分類：逐項填上實際點到的數量" Click="Stocktake_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="盤點" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" ToolTip="查看借出中的工具與所有購入、報廢、借出、歸還、盤點紀錄" Click="Records_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="紀錄"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" Click="Export_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯出 Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Import_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="匯入 Excel"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" ToolTip="在桌面建立（或修復）工具盤點的捷徑" Click="Shortcut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="桌面捷徑"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="檢查更新"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentGradient}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#4F46E5"/>
                </Border.Effect>
                <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="21" Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="工具盤點" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,1,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== 主內容 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 最左：分類（全部工具 / 自訂分類 / 未分類） -->
            <Border Grid.Column="0" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,16,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="6,0,0,10">
                        <Button DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource FieldIconButton}"
                                Width="28" Height="28" FontSize="12" ToolTip="新增分類" Click="NewCategory_Click"/>
                        <TextBlock Text="分類" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="CategoryList" Grid.Row="1" Style="{StaticResource CategoryListStyle}" SelectionMode="Single"
                             SelectionChanged="CategoryList_SelectionChanged" ContextMenuOpening="CategoryList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Display}"/>
                                    <TextBlock x:Name="CountLabel" Grid.Column="2" Text="{Binding Count}" FontSize="12" Margin="8,0,4,0"
                                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    <!-- 滑過自訂分類時，數字換成「重新命名 / 刪除」按鈕 -->
                                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                        <Button Content="&#xE70F;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="12"
                                                ToolTip="重新命名分類" Click="RenameCategory_Click"/>
                                        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" FontSize="12"
                                                ToolTip="刪除分類" Click="DeleteCategory_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                            <Condition Binding="{Binding IsUserCategory}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="CountLabel" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 中：搜尋 + 清單 -->
            <Border Grid.Column="2" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="SearchBox" Padding="38,9,12,9" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SubtleBrush}"
                                   Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="搜尋名稱、規格、單位、備註…" Margin="40,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox x:Name="ToolList" Grid.Row="1" Style="{StaticResource EntryListStyle}"
                             ItemTemplate="{StaticResource ToolTemplate}" SelectionMode="Single"
                             SelectionChanged="ToolList_SelectionChanged" ContextMenuOpening="ToolList_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- 空清單提示 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyText" TextAlignment="Center" LineHeight="20"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=ToolList}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：編輯 -->
            <Border Grid.Column="4" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,20,20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,18">
                        <!-- 清空表單，準備新增下一項 -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12"
                                ToolTip="清空表單，準備新增工具" Click="ClearForm_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="清空"/>
                            </StackPanel>
                        </Button>
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="工具資料" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="名稱 *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

                            <TextBlock Text="分類" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryBox" Margin="0,0,0,14" DisplayMemberPath="Display" SelectedValuePath="Name"/>

                            <TextBlock Text="規格 / 型號" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SpecBox" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="在庫數量" Style="{StaticResource FieldLabel}"/>
                                    <!-- 數量欄右側：減一 / 加一 -->
                                    <Grid>
                                        <TextBox x:Name="QtyBox" Padding="12,8,76,8" Text="0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                            <Button Content="&#xE738;" Style="{StaticResource FieldIconButton}" ToolTip="減 1"
                                                    Click="QtyMinus_Click"/>
                                            <Button Content="&#xE710;" Style="{StaticResource FieldIconButton}" ToolTip="加 1"
                                                    Margin="2,0,0,0" Click="QtyPlus_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="單位" Style="{StaticResource FieldLabel}"/>
                                    <!-- 單位欄右側：從預設單位挑選（清單可在選單底部管理），也可以直接輸入 -->
                                    <Grid>
                                        <TextBox x:Name="UnitBox" Padding="12,8,38,8" ToolTip="可直接輸入，或按右側箭頭選擇預設單位"/>
                                        <Button x:Name="UnitPickButton" Content="&#xE70D;" Style="{StaticResource FieldIconButton}" FontSize="11"
                                                HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="選擇預設單位" Click="UnitPick_Click"/>
                                        <!-- 預設單位面板：單位排成小方塊（由程式產生），底部是「管理預設單位」 -->
                                        <Popup x:Name="UnitPopup" PlacementTarget="{Binding ElementName=UnitBox}" Placement="Bottom"
                                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="UnitPopup_Closed">
                                            <Border Width="{x:Static local:MainWindow.UnitPopupWidth}" Margin="0,4,8,10" Padding="10,10,10,6" CornerRadius="10"
                                                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.12"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="預設單位" Style="{StaticResource FieldLabel}"/>
                                                    <WrapPanel x:Name="UnitChips"/>
                                                    <TextBlock x:Name="UnitChipsEmpty" Text="還沒有預設單位" FontSize="12" Margin="2,0,0,8"
                                                               Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
                                                    <Border Height="1" Margin="0,2,0,4" Background="{DynamicResource LineBrush}"/>
                                                    <Button Style="{StaticResource GhostButton}" Padding="8,6" FontSize="12" HorizontalAlignment="Left"
                                                            Click="ManageUnits_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                                            <TextBlock Text="管理預設單位…"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 購入日期（可修改）與最後盤點日期（盤點時自動記錄） -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="購入日期" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <TextBox x:Name="PurchasedBox" Padding="12,8,52,8"
                                                 ToolTip="第一次買進來的日期，例如 2026/10/8 或 115/10/8；不知道可以空白"/>
                                        <Button Content="今天" Style="{StaticResource GhostButton}" Padding="6,3" FontSize="12" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="填入今天的日期" Click="PurchasedToday_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="最後盤點" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="CheckedBox" IsReadOnly="True" IsTabStop="False" Foreground="{DynamicResource MutedBrush}"
                                             ToolTip="按上方「盤點」完成盤點後會自動記錄"/>
                                </StackPanel>
                            </Grid>

                            <!-- 動作：對清單選取的工具直接動作，會改在庫數量並留下紀錄（不用再按「儲存修改」） -->
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="12"
                                        ToolTip="查看這項工具的購入、報廢、借出、歸還、盤點紀錄" Click="ItemRecords_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="紀錄"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="動作" Style="{StaticResource FieldLabel}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <UniformGrid Columns="4" Rows="1">
                                <Button Margin="0,0,4,0" Padding="4,8" FontSize="12" ToolTip="又買了幾個進來，要寫購入日期" Click="Buy_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="購入"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="2,0,2,0" Padding="4,8" FontSize="12" ToolTip="壞掉、遺失或汰換，要寫報廢日期與原因" Click="Scrap_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                        <TextBlock Text="報廢"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="2,0,2,0" Padding="4,8" FontSize="12" ToolTip="借給別人，之後要歸還" Click="Lend_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource WarnBrush}"/>
                                        <TextBlock Text="借出"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="4,0,0,0" Padding="4,8" FontSize="12" ToolTip="借出的東西還回來（沒選工具時可從全部借出中挑）" Click="Return_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock Text="歸還"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <TextBlock x:Name="LoanInfoText" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="2,8,0,0"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <TextBlock x:Name="ScrapInfoText" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="2,6,0,0"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                            <Border Height="14"/>

                            <TextBlock Text="備註" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NoteBox" Margin="0,0,0,10" Height="90" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock x:Name="UpdatedText" FontSize="12" Foreground="{DynamicResource SubtleBrush}" Margin="2,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 操作按鈕固定在卡片底部，表單再長也不會被捲出畫面 -->
                    <UniformGrid Grid.Row="2" Columns="3" Rows="1" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Padding="10,10" Click="Add_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="新增"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="5,0,5,0" Padding="10,10" Click="Save_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="儲存修改"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Margin="5,0,0,0" Padding="10,10" Click="Delete_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="刪除"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 頁尾 ===== -->
        <DockPanel Grid.Row="2" Margin="4,12,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" FontSize="12" Padding="12,6" Click="DeleteAll_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="全部刪除"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
