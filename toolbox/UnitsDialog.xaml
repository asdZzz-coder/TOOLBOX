<Window x:Class="toolbox.UnitsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="預設單位" Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/app.ico"
        Background="{DynamicResource CardBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- 管理「單位」欄下拉選單裡的預設單位：新增、刪除、調整順序 -->
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="這些單位會出現在「單位」欄的下拉選單，點一下就能填入；清單以外的單位仍可直接輸入。"
                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,0,14"/>

        <TextBlock Text="新增單位" Style="{StaticResource FieldLabel}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewUnitBox" TextChanged="NewUnitBox_TextChanged" PreviewKeyDown="NewUnitBox_PreviewKeyDown"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,8" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                    <TextBlock Text="新增"/>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Margin="2,16,0,6">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource SubtleBrush}"/>
            <TextBlock Text="單位清單（滑過可調整順序或刪除）" Style="{StaticResource FieldLabel}" Margin="0"/>
        </DockPanel>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
            <Grid>
                <ListBox x:Name="UnitList" Height="280" Style="{StaticResource CategoryListStyle}" SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Visibility="Hidden">
                                    <Button Content="&#xE74A;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="12"
                                            ToolTip="往上移" Click="MoveUp_Click"/>
                                    <Button Content="&#xE74B;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="12"
                                            ToolTip="往下移" Click="MoveDown_Click"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" FontSize="12"
                                            ToolTip="刪除單位" Click="Remove_Click"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="清單是空的，在上方輸入單位後按「新增」" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Padding="10,8" FontSize="12"
                    ToolTip="換回內建的單位清單" Click="Reset_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="恢復預設"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True" MinWidth="88" Margin="0,0,8,0" Content="取消"/>
                <Button Style="{StaticResource PrimaryButton}" MinWidth="88" Content="確定" Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
