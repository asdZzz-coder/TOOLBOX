<Window x:Class="toolbox.ReturnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="歸還工具" Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/app.ico"
        Background="{DynamicResource CardBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- 歸還：選一筆借出、輸入歸還數量（可以只還一部分） -->
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="選擇要歸還的借出" Style="{StaticResource FieldLabel}"/>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="6,6,2,2" Margin="0,0,0,16">
            <ListBox x:Name="LoanList" MaxHeight="250" Style="{StaticResource EntryListStyle}" SelectionMode="Single"
                     SelectionChanged="LoanList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{Binding ItemDisplay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Detail}"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                                    Background="{DynamicResource WarnSoftBrush}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}">
                                    <Run Text="未還"/>
                                    <Run Text="{Binding OutstandingDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="QtyLabel" Text="歸還數量 *" Style="{StaticResource FieldLabel}"/>
        <Grid>
            <TextBox x:Name="QtyBox" Padding="12,8,76,8" TextChanged="Field_TextChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                <Button Content="&#xE738;" Style="{StaticResource FieldIconButton}" ToolTip="減 1" Click="QtyMinus_Click"/>
                <Button Content="&#xE710;" Style="{StaticResource FieldIconButton}" ToolTip="加 1" Margin="2,0,0,0" Click="QtyPlus_Click"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="PreviewText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,14"/>

        <TextBlock Text="說明（選填，例如：有損壞、少一個零件）" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NoteBox" TextChanged="Field_TextChanged"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button IsCancel="True" MinWidth="88" Margin="0,0,8,0" Content="取消"/>
            <Button Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88" Content="歸還" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
